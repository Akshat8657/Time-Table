# =====================================================================
#  TimeTablePro - SETTINGS SAMPLE  (.env.example)
#
#  Ye sirf ek NAMUNA (sample) file hai - isme sirf PLACEHOLDERS hain.
#  ASLI keys kabhi is file me mat likhna.
#  Asli keys sirf ".env" file me jaati hain (wo file kisi ko share mat karna,
#  backup zip me bhi nahi jaati).
#  Har setting ke upar ek line me likha hai ki wo kya karti hai. Line hi na ho = default.
#  Internet par chalane se pehle: PRODUCTION_CHECKLIST.md
# =====================================================================


# ---------------------------------------------------------------------
# 1) SUPABASE  (zaroori - chaaron values chahiye)
# ---------------------------------------------------------------------
# Project URL, jaise: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (sb_publishable_...) ya purani "anon" key (eyJ...)
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# "Secret key" (sb_secret_...) ya purani "service_role" key - bahut powerful, kisi ko mat dena
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Database connection string - "Session pooler" wali (port 5432); YOUR-DB-PASSWORD ki jagah database password
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres


# ---------------------------------------------------------------------
# 2) PEHLA ADMIN ACCOUNT  (python -m scripts.seed_admin ; --reset = naya temporary password)
# ---------------------------------------------------------------------
# Is email se admin login karega
SEED_ADMIN_EMAIL=admin@example.com
# Admin ka naam (sirf pehli baar)
SEED_ADMIN_NAME=College Admin


# ---------------------------------------------------------------------
# 3) LOGIN SESSION
# ---------------------------------------------------------------------
# Itne ghante kuch na karo to apne aap logout (default 8)
SESSION_IDLE_TIMEOUT_HOURS=8
# Bina "Remember me" ke ek login maximum itne ghante (default 24)
SESSION_ABSOLUTE_MAX_HOURS=24
# "Remember me" ke saath itne din kuch na karo tab tak login rehta hai (default 30)
REMEMBER_ME_DAYS=30
# "Remember me" wale login ki maximum umar, din me (default 90)
REMEMBER_ME_ABSOLUTE_MAX_DAYS=90
# Ek login-check itne second yaad rakha jata hai (speed); logout / deactivate turant asar karte hain (default 5)
SESSION_CACHE_SECONDS=5


# ---------------------------------------------------------------------
# 4) SECURITY / SERVER
# ---------------------------------------------------------------------
# development (laptop) / production (internet) - production me unsafe settings hon to server start hi nahi hota
APP_ENV=development
# Sirf ye websites backend se baat kar sakti hain (CORS) - production me https://aapki-website
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Backend sirf in naamon (Host header) se khulta hai - production me aapka domain
ALLOWED_HOSTS=localhost,127.0.0.1
# Login cookie sirf HTTPS par bheji jaye (production me apne aap true)
COOKIE_SECURE=false
# lax = website + API ek hi site par (normal); none = alag-alag sites par (HTTPS zaroori)
COOKIE_SAMESITE=lax
# true SIRF tab jab app aapke apne reverse proxy ke peeche ho (tab client ka address X-Forwarded-For ki aakhri entry se)
TRUST_PROXY_HEADERS=false
# Ek request ka maximum size, MB me (photo 5 MB aur Excel 2 MB tak hote hain; default 8)
MAX_REQUEST_MB=8
# Ek email par itni galat login koshish ke baad 15 minute ka rok (default 5)
LOGIN_MAX_FAILED_ATTEMPTS=5
# ... galat koshishein itne minute me gini jaati hain (default 15)
LOGIN_WINDOW_MINUTES=15
# Ek computer (IP) se itni GALAT login koshish allowed, kisi bhi email ke liye (default 30)
LOGIN_IP_MAX_ATTEMPTS=30
# API docs page (/api/docs) - production me hamesha false
ENABLE_API_DOCS=false
# Database connections: Supabase free tier pe SAB programs milakar 15 - app ke liye kam se kam / zyada se zyada (default 3 / 6; internet par jab sirf app ho to 10 tak)
DB_POOL_MIN=3
DB_POOL_MAX=6
# Timetable data itne second memory me rakha jata hai (speed); app ke andar ka har badlav use turant hata deta hai (default 30, 0 = band)
READ_CACHE_SECONDS=30


# ---------------------------------------------------------------------
# 5) BROWSER ALERTS (Web Push) - backend folder me:  python -m scripts.gen_vapid  (apne aap bharta hai)
# ---------------------------------------------------------------------
# Public key (browser ko diya jata hai). Khali = browser alerts band, bell phir bhi chalti hai
VAPID_PUBLIC_KEY=
# Private key - kabhi share mat karna, kabhi badalna mat (warna purane alerts band ho jaate hain)
VAPID_PRIVATE_KEY=
# Contact jo push services ko bataya jata hai
VAPID_SUBJECT=mailto:admin@timetablepro.example


# ---------------------------------------------------------------------
# 6) SUBSTITUTION
# ---------------------------------------------------------------------
# Auto popup-offer itne minute rukta hai, phir HOD ko alert (default 10)
SUBSTITUTION_OFFER_MINUTES=10


# ---------------------------------------------------------------------
# 7) AI ASSISTANT (Gemini)
# ---------------------------------------------------------------------
# FREE key (card nahi chahiye): https://aistudio.google.com/apikey -> "Create API key". Khali = AI band, baaki app chalta hai
GEMINI_API_KEY=
# Models isi order me try hote hain (Google purane naam band karta hai to yahan badlo)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Gemini ke jawab ka itne second tak intezaar (default 20)
GEMINI_TIMEOUT_SECONDS=20
# Ek insaan ek minute me itne AI messages bhej sakta hai (free quota bachane ke liye; default 12)
ASSISTANT_MESSAGES_PER_MINUTE=12
# (sirf automatic tests ke liye - mat badlo) Gemini ka address, aur quota-khatam par model ko kitna aaram dena (1 = normal)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_COOLDOWN_SCALE=1
