# =====================================================================
#  TimeTablePro - SETTINGS SAMPLE  (.env.example)
#
#  Ye sirf ek NAMUNA (sample) file hai - isme sirf PLACEHOLDERS hain.
#  ASLI keys kabhi is file me mat likhna.
#  Asli keys sirf ".env" file me jaati hain (wo file kisi ko share mat karna,
#  backup zip me bhi nahi jaati).
# =====================================================================


# ---------------------------------------------------------------------
# 1) SUPABASE  (zaroori - chaaron values chahiye)
#    Supabase dashboard se copy karni hain (steps README me / chat me diye hain)
# ---------------------------------------------------------------------

# Project URL, jaise: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# "Publishable key" (sb_publishable_...)  ya  purani "anon" key (eyJ...)
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# "Secret key" (sb_secret_...)  ya  purani "service_role" key (eyJ...)
# DHYAN: ye key bahut powerful hai - kisi ko mat dena.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Database connection string - "Session pooler" wali (port 5432, IPv4 pe chalti hai)
# [YOUR-PASSWORD] ki jagah apna database password daalo.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres


# ---------------------------------------------------------------------
# 2) PEHLA ADMIN ACCOUNT  (sirf ek baar banta hai)
# ---------------------------------------------------------------------

# Is email se admin login karega (apna asli email daalo)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=College Admin


# ---------------------------------------------------------------------
# 3) LOGIN SESSION  (kab tak login rahega)
# ---------------------------------------------------------------------

# Itne ghante kuch na karo to apne aap logout ho jaata hai (default 8)
SESSION_IDLE_TIMEOUT_HOURS=8

# Bina "Remember me" ke, ek login maximum itne ghante chalta hai (default 24)
SESSION_ABSOLUTE_MAX_HOURS=24

# "Remember me" tick ho to itne din kuch na karo tab tak login rehta hai (default 30)
REMEMBER_ME_DAYS=30

# "Remember me" wale login ki maximum umar, din me (default 90)
REMEMBER_ME_ABSOLUTE_MAX_DAYS=90


# ---------------------------------------------------------------------
# 4) SECURITY / SERVER  (normally inhe chhedna nahi hai)
# ---------------------------------------------------------------------

# Sirf ye websites backend se baat kar sakti hain (CORS - sirf localhost)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend sirf in naamon se khulta hai
ALLOWED_HOSTS=localhost,127.0.0.1

# Cookie "Secure" flag. Localhost (http) par false rakho. HTTPS lagne par true.
COOKIE_SECURE=false

# Login rate limit: ek email par itni galat koshish ke baad rok do
LOGIN_MAX_FAILED_ATTEMPTS=5
# ... itne minute ke andar
LOGIN_WINDOW_MINUTES=15
# Ek computer (IP) se itni GALAT login koshish allowed (kisi bhi email ke liye)
LOGIN_IP_MAX_ATTEMPTS=30

# API docs page (/docs). Normally false rakho.
ENABLE_API_DOCS=false

# development / production
APP_ENV=development


# ---------------------------------------------------------------------
# 5) BROWSER ALERTS (Web Push) - Phase 4
# ---------------------------------------------------------------------
# Ye 3 lines apne aap ban jaati hain: backend folder me chalao   python -m scripts.gen_vapid
# (pehle se bani hui key kabhi badli nahi jaati - warna purane alerts band ho jaate). Khali = browser alerts band, bell phir bhi chalti hai.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@timetablepro.example

# ---------------------------------------------------------------------
# 6) AI ASSISTANT (Gemini) - Phase 7
# ---------------------------------------------------------------------
# FREE key (card nahi chahiye): https://aistudio.google.com/apikey  ->  "Create API key"
# Asli key sirf ".env" me daalna. Khali = AI band ("AI abhi available nahi hai" dikhega), baaki app poora chalta hai.
GEMINI_API_KEY=
